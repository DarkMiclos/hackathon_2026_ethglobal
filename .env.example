# MultiBaas
# Get these from console.curvegrid.com after creating a Sepolia deployment
VITE_MULTIBAAS_URL=https://YOUR_DEPLOYMENT.multibaas.com
VITE_MULTIBAAS_API_KEY=your_api_key_here

# Optional: Sepolia RPC (viem uses a public default, but a dedicated one is faster)
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional: throwaway Sepolia private key for the "Simulate Swaps" panel.
# It is bundled into the browser build, so never use a key that holds real funds.
VITE_TEST_PRIVATE_KEY=

# Production (Vercel): set these WITHOUT the VITE_ prefix as project environment variables.
# The serverless proxy in api/multibaas.js injects the key server-side, so the
# deployed bundle never contains it and no CORS origin needs to be configured in MultiBaas.
# MULTIBAAS_URL=https://YOUR_DEPLOYMENT.multibaas.com
# MULTIBAAS_API_KEY=read_only_key
# MULTIBAAS_PROXY_ALLOWED_ORIGINS=   # optional, comma-separated extra origins allowed to call the proxy
# Set VITE_MULTIBAAS_PROXY=false to call MultiBaas directly from the browser instead
# (then add your site origin under MultiBaas > Admin > CORS and ship VITE_MULTIBAAS_* too).
